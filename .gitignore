# WordPress plugins — коммитим для полной копии при развёртывании в Docker
# wp-content/plugins/
# Разрешаем тему
!wp-content/themes/oor-theme/

# WooCommerce: слишком большой для git (~65 MB, 1000+ файлов при обновлении).
# Устанавливается через wp-cli при старте контейнера (см. start.sh).
wp-content/plugins/woocommerce/

# Переводы: устанавливаются через wp-cli при старте контейнера.
wp-content/languages/

# Always Works Guide (internal documentation)
ALWAYS_WORKS_GUIDE.md

# Документация (локальные изменения)
docs_backup_*.tar.gz
docs_backup_*/

# Локальные SSL-сертификаты
ssl/*.pem
certs/*.pem
certs/*.crt
certs/*.key

# Let's Encrypt webroot (на сервере)
certbot-webroot/
docker-compose.override.yml

# WordPress: кэш и служебные (uploads и wordpress-uploads коммитим — полный слепок в Docker)
# wordpress-uploads/
# wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/wflogs/
wp-content/debug.log

# Локальные mu-плагины для дев-среды
wp-content/mu-plugins/local-https-url.php

# Медиа темы хранятся через Git LFS (mp4, webm, png, avif, woff2 и т.д.)

# Локальные дампы и бэкапы (не в репо)
local-wordpress.sql
local_backup_*.sql
wp-content/ai1wm-backups/

